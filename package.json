{
  "name": "dia-live",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:restart": "powershell -ExecutionPolicy Bypass -File ./scripts/restart-dev.ps1",
    "dev:frontend": "next dev --turbopack -p 3000",
    "dev:backend": "convex dev",
    "build": "node scripts/build.mjs",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "npm run test:pin-guard && npm run test:m2-live-verifier && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:pin-guard": "node scripts/check-no-pin-deps.mjs",
    "test:m2-live-verifier": "node --test scripts/verify-m2-live.test.mjs",
    "verify:new-app-target": "node scripts/verify-new-app-convex-target.mjs",
    "verify:m2-live": "node scripts/verify-m2-live.mjs",
    "seed:new-app": "npm run verify:new-app-target && npx convex run seed/refereeFirst:init",
    "results:update": "npx convex run import/weeklyUpdate:runNow",
    "predev": "convex dev --until-success",
    "postinstall": "npx convex codegen || true"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.0.1",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "convex-helpers": "^0.1.123",
    "lucide-react": "^0.468.0",
    "next": "^16.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.3",
    "convex-test": "^0.0.56",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^28.0.0",
    "npm-run-all": "^4.1.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
